# Nicht ins Function-Bundle: hält den Deploy klein und verhindert, dass
# lokale Daten oder Geheimnisse hochgeladen werden.

.venv/
__pycache__/
*.pyc
.pytest_cache/

# Lokale Daten (SQLite-DB + Uploads) — auf Vercel kommen Neon + Blob zum Einsatz
data/

# Geheimnisse: Env-Vars werden im Vercel-Dashboard gepflegt
.env

# macOS/exFAT-Schattendateien — Alembic würde ._*.py als Migrationen einlesen
._*
.DS_Store

